{
  "name": "ume-interiors-quotation-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/lib/*.test.ts src/lib/*.test.tsx backend/*.test.ts",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit",
    "worker:dev": "wrangler dev --config wrangler.toml",
    "deploy": "npm run build && wrangler deploy --config wrangler.toml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "qrcode": "1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
