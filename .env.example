# Copy to .env for the local Express server. Never commit your .env.
# Set your own username (3–64 letters/numbers/dots/underscores/hyphens).
OWNER_USERNAME="owner"
# Set a unique password of at least 12 characters before first sign-in.
OWNER_PASSWORD=""
HOST="127.0.0.1"
PORT="3000"

# Cloudflare local preview reads .dev.vars instead of .env.
# Production uses: npx wrangler --config ./wrangler.toml secret put OWNER_USERNAME
#                  npx wrangler --config ./wrangler.toml secret put OWNER_PASSWORD
# The first successful configuration is hashed into persistent storage.
# Change credentials in /owner after signing in; environment values do not
# overwrite a saved account on subsequent starts/deployments.
